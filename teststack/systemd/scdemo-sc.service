[Unit]
Description=service-control-ioc for the scdemo test stack
After=dbus.service
[Service]
Type=simple
User=scdemo
Group=scdemo
SupplementaryGroups=systemd-journal
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/scdemo/ca.env
ExecStart=/opt/service-control-ioc/venv/bin/service-control-ioc /etc/scdemo/scdemo-sc.yaml
Restart=on-failure
RestartSec=5
[Install]
WantedBy=multi-user.target
